# Root-level example — most env vars actually live per-app (see
# apps/*/.env.example). This file is for anything genuinely shared.

# Supabase local dev (matches supabase/config.toml defaults; printed again
# by `npx supabase start`).
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
